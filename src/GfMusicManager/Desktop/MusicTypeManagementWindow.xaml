<Window x:Class="GfMusicManager.Desktop.MusicTypeManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GfMusicManager.Desktop.Localization"
        Title="{loc:Loc Management.WindowTitle}"
        Width="1160"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0f141c"
        Foreground="#edf2f8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#1b2330" />
        <SolidColorBrush x:Key="PanelRaisedBackground" Color="#222c3b" />
        <SolidColorBrush x:Key="BorderBrush" Color="#344154" />
        <SolidColorBrush x:Key="MutedForeground" Color="#9aa8ba" />
        <SolidColorBrush x:Key="BlueAccent" Color="#78a9e8" />
        <SolidColorBrush x:Key="BluePanel" Color="#263d5c" />
        <SolidColorBrush x:Key="GreenAccent" Color="#8bcaa6" />

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="Background" Value="#141b25" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="Background" Value="#273243" />
            <Setter Property="BorderBrush" Value="#42536a" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33445a" />
                                <Setter Property="BorderBrush" Value="#637e9f" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#41648f" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Background" Value="#4e79ae" />
            <Setter Property="BorderBrush" Value="#78a9e8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#141b25" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202a38" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BluePanel}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock Text="{Binding SummaryText}"
                           DockPanel.Dock="Right"
                           Foreground="{StaticResource MutedForeground}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <TextBlock Text="{loc:Loc Management.Heading}"
                           FontSize="20"
                           FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock Text="{loc:Loc Management.Description}"
                       Foreground="{StaticResource MutedForeground}"
                       FontSize="12"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12"
                    Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchTextBox"
                                 ToolTip="{loc:Loc Management.SearchTooltip}" />
                        <Button Grid.Column="1"
                                Content="{loc:Loc Common.Search}"
                                Style="{StaticResource WindowButton}"
                                Margin="8,0,0,0"
                                Click="SearchButton_Click" />
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Text="{Binding FilteredSummaryText}"
                               Foreground="{StaticResource MutedForeground}"
                               FontSize="10"
                               Margin="2,8,0,6" />
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding FilteredTypes}"
                             SelectedItem="{Binding SelectedType, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayText}"
                                               Foreground="{StaticResource BlueAccent}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SummaryText}"
                                               Foreground="{StaticResource MutedForeground}"
                                               FontSize="10"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding SelectedTypeVisibility}">
                        <StackPanel>
                            <Border Background="{StaticResource PanelRaisedBackground}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="12">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding SelectedType.SummaryText}"
                                                   DockPanel.Dock="Right"
                                                   Foreground="{StaticResource GreenAccent}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedType.DisplayText}"
                                                   Foreground="{StaticResource BlueAccent}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding SelectedType.RecordSummaryText}"
                                               FontSize="11"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap" />
                                    <Expander Header="{loc:Loc Management.TechnicalInfo}"
                                              Margin="0,8,0,0">
                                        <TextBlock Text="{Binding SelectedType.TechnicalText}"
                                                   Foreground="{StaticResource MutedForeground}"
                                                   FontSize="10"
                                                   Margin="8,4,0,0"
                                                   TextWrapping="Wrap" />
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Expander Header="{Binding SelectedType.TrackHeaderText}"
                                      IsExpanded="False"
                                      Foreground="{StaticResource BlueAccent}"
                                      FontSize="13"
                                      FontWeight="SemiBold"
                                      Margin="0,16,0,7">
                                <ItemsControl ItemsSource="{Binding SelectedType.Tracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource PanelRaisedBackground}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="9"
                                                    Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayText}"
                                                               Foreground="{StaticResource BlueAccent}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding AudioText}"
                                                               Foreground="{StaticResource MutedForeground}"
                                                               FontSize="10"
                                                               Margin="0,3,0,0"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding ConditionsText}"
                                                               Foreground="{StaticResource MutedForeground}"
                                                               FontSize="10"
                                                               Margin="0,2,0,0"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding RecordText}"
                                                               Foreground="{StaticResource MutedForeground}"
                                                               FontSize="9"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <TextBlock Text="{Binding SelectedType.DefinitionHeaderText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,16,0,7" />
                            <ItemsControl ItemsSource="{Binding SelectedType.DefinitionGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Header="{Binding HeaderText}"
                                                  IsExpanded="True"
                                                  Foreground="{StaticResource BlueAccent}"
                                                  Margin="0,0,0,6">
                                            <Border Background="#18202b"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="0,0,6,6"
                                                    Padding="9">
                                                <ItemsControl ItemsSource="{Binding Entries}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,7">
                                                                <TextBlock Text="{Binding DisplayText}"
                                                                           Foreground="#dceaff"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding DetailText}"
                                                                           Foreground="{StaticResource MutedForeground}"
                                                                           FontSize="10"
                                                                           Margin="0,2,0,0"
                                                                           TextWrapping="Wrap" />
                                                                <Expander Header="{loc:Loc Management.TechnicalInfo}"
                                                                          Margin="0,3,0,0">
                                                                    <TextBlock Text="{Binding TechnicalText}"
                                                                               Foreground="{StaticResource MutedForeground}"
                                                                               FontSize="9"
                                                                               Margin="8,3,0,0"
                                                                               TextWrapping="Wrap" />
                                                                </Expander>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Text="{loc:Loc Management.Empty}"
                               Visibility="{Binding EmptyStateVisibility}"
                               Foreground="{StaticResource MutedForeground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{loc:Loc Management.Footer}"
                       Foreground="{StaticResource MutedForeground}"
                       FontSize="10"
                       VerticalAlignment="Center" />
            <Button Content="{loc:Loc Common.Close}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButton}"
                    Margin="14,0,0,0"
                    Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
