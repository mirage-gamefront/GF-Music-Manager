<Window x:Class="GfMusicManager.Desktop.MusicSourceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GfMusicManager.Desktop.Localization"
        Title="{loc:Loc SourceDetails.WindowTitle}"
        Width="1180"
        Height="820"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0f141c"
        Foreground="#edf2f8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#1b2330" />
        <SolidColorBrush x:Key="PanelRaisedBackground" Color="#222c3b" />
        <SolidColorBrush x:Key="BorderBrush" Color="#344154" />
        <SolidColorBrush x:Key="MutedForeground" Color="#9aa8ba" />
        <SolidColorBrush x:Key="BlueAccent" Color="#78a9e8" />
        <SolidColorBrush x:Key="BluePanel" Color="#263d5c" />
        <SolidColorBrush x:Key="GreenAccent" Color="#8bcaa6" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PopupButton" TargetType="Button">
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="Background" Value="#273243" />
            <Setter Property="BorderBrush" Value="#42536a" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33445a" />
                                <Setter Property="BorderBrush" Value="#637e9f" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#41648f" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupPrimaryButton" TargetType="Button" BasedOn="{StaticResource PopupButton}">
            <Setter Property="Background" Value="#4e79ae" />
            <Setter Property="BorderBrush" Value="#78a9e8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="Background" Value="#141b25" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#17202c" />
            <Setter Property="Background" Value="#edf2f8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#17202c" />
            <Setter Property="Background" Value="#edf2f8" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Foreground" Value="#ffffff" />
                    <Setter Property="Background" Value="#4e79ae" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#ffffff" />
                    <Setter Property="Background" Value="#263d5c" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#141b25" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202a38" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BluePanel}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource MutedForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedForeground}" />
            <Setter Property="Background" Value="#18202b" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#26384f" />
                                <Setter Property="Foreground" Value="#edf2f8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BluePanel}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#78a9e8" />
                                <Setter Property="Foreground" Value="#edf2f8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Loc SourceDetails.Heading}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc SourceDetails.Description}"
                       Foreground="{StaticResource MutedForeground}"
                       FontSize="12"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelRaisedBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14"
                    Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:Loc SourceDetails.TargetAudio}" Foreground="{StaticResource MutedForeground}" FontSize="10" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding TrackTitle}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding SourceText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AudioText}"
                                   Foreground="{StaticResource MutedForeground}"
                                   FontSize="10"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding AudioText}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1"
                    Background="{StaticResource PanelRaisedBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14"
                    Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc SourceDetails.AudioState}" Foreground="{StaticResource MutedForeground}" FontSize="10" />
                    <TextBlock Text="{Binding AssetStateText}" FontSize="11" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding AssetPathText}"
                               Foreground="{StaticResource MutedForeground}"
                               FontSize="10"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding AssetPathToolTipText}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.03*" />
                <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14"
                    Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc SourceDetails.TrackHeading}" FontSize="14" FontWeight="SemiBold" />
                            <Button Grid.Column="1"
                                    Content="{loc:Loc SourceDetails.TypeManagementButton}"
                                    Style="{StaticResource PopupButton}"
                                    Padding="9,5"
                                    Margin="8,0,0,0"
                                    Click="OpenMusicTypeManagementButton_Click"
                                    ToolTip="{loc:Loc SourceDetails.TypeManagementTooltip}" />
                        </Grid>
                        <TextBlock Text="{loc:Loc SourceDetails.TrackDescription}"
                                   Foreground="{StaticResource MutedForeground}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,12" />
                        <Expander Header="{Binding SelectedMusicTrackHeaderText}"
                                  IsExpanded="False"
                                  Margin="0,0,0,10">
                            <StackPanel>
                                <ListBox ItemsSource="{Binding SelectedMusicTrackGroups}"
                                     SelectedItem="{Binding SelectedMusicTrackGroup, Mode=TwoWay}"
                                     SelectionMode="Single"
                                     MaxHeight="260"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="7"
                                                Padding="9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#18202b" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BluePanel}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource BlueAccent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayText}"
                                                           Foreground="{StaticResource BlueAccent}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding AudioText}"
                                                           Foreground="{StaticResource MutedForeground}"
                                                           FontSize="10"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ConditionsText}"
                                                           Foreground="{StaticResource MutedForeground}"
                                                           FontSize="10"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DefinitionText}"
                                                           Foreground="{StaticResource MutedForeground}"
                                                           FontSize="10"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap" />
                                                <Expander Header="{Binding TechnicalHeaderText}">
                                                    <ItemsControl ItemsSource="{Binding SourceDetails}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#141b25"
                                                                        BorderBrush="{StaticResource BorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="5"
                                                                        Padding="7"
                                                                        Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding TechnicalText}"
                                                                               Foreground="{StaticResource MutedForeground}"
                                                                               FontSize="10"
                                                                               TextWrapping="Wrap" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Background="#18202b"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="9"
                                    Visibility="{Binding SelectedMusicTrackEmptyVisibility}">
                                    <TextBlock Text="{loc:Loc SourceDetails.NotAnalyzed}"
                                           Foreground="{StaticResource MutedForeground}" />
                                </Border>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="{loc:Loc SourceDetails.MusicTypeMembership}"
                                   Foreground="{StaticResource MutedForeground}"
                                   FontSize="10"
                                   Margin="0,0,0,5" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CurrentMusicTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelRaisedBackground}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayText}"
                                                           Foreground="{StaticResource BlueAccent}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DefinitionText}"
                                                           Foreground="{StaticResource MutedForeground}"
                                                           FontSize="10"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding PluginText}"
                                                           Foreground="{StaticResource MutedForeground}"
                                                           FontSize="10"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="{loc:Loc SourceDetails.TypeManagementDetailsButton}"
                                                    Style="{StaticResource PopupButton}"
                                                    Padding="8,5"
                                                    Margin="8,0,0,0"
                                                    Tag="{Binding FormKey}"
                                                    Click="OpenMusicTypeManagementButton_Click"
                                                    ToolTip="{loc:Loc SourceDetails.TypeManagementDetailsTooltip}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14"
                    Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc SourceDetails.EditHeading}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc SourceDetails.EditDescription}"
                                   Foreground="{StaticResource MutedForeground}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,3" />
                        <Border Background="#18202b"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedMusicTrackEditorHeaderText}"
                                           Foreground="{StaticResource BlueAccent}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedMusicTrackEditorSummaryText}"
                                           Foreground="{StaticResource MutedForeground}"
                                           FontSize="10"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TabControl Grid.Row="1"
                                SelectedIndex="0"
                                IsEnabled="{Binding HasSelectedMusicTrack}"
                                Margin="0,12,0,0">
                        <TabItem Header="{loc:Loc SourceDetails.MusicTypeTab}">
                            <Border Background="#18202b"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0,7,7,7"
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc SourceDetails.AssignHeading}" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc SourceDetails.AssignDescription}"
                                                   Foreground="{StaticResource MutedForeground}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,6" />
                                    </StackPanel>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding MusicTypeOptions}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="58" VerticalAlignment="Top">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayText}"
                                                                   Foreground="{StaticResource BlueAccent}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding DetailText}"
                                                                   Foreground="{StaticResource MutedForeground}"
                                                                   FontSize="9"
                                                                   Margin="0,2,0,0"
                                                                   TextWrapping="Wrap"
                                                                   ToolTip="{Binding TechnicalText}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="{loc:Loc SourceDetails.RemoveButton}"
                                                            Style="{StaticResource PopupButton}"
                                                            Padding="7,4"
                                                            Margin="0"
                                                            Tag="{Binding}"
                                                            Click="RemoveMusicTypeButton_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Grid.Row="2"
                                            Content="{loc:Loc SourceDetails.AddMusicTypeButton}"
                                            Style="{StaticResource PopupButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0"
                                            Click="AddMusicTypeButton_Click" />
                                </Grid>
                            </Border>
                        </TabItem>

                        <TabItem Header="{loc:Loc SourceDetails.TrackConditionsTab}">
                            <Border Background="#18202b"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0,7,7,7"
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding ConditionInstructionText}"
                                               Foreground="{StaticResource BlueAccent}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ConditionGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource PanelRaisedBackground}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="9"
                                                        Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Left">
                                                                <TextBlock Text="{Binding Title}"
                                                                           Foreground="{StaticResource BlueAccent}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Description}"
                                                                           Foreground="{StaticResource MutedForeground}"
                                                                           FontSize="10"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <ComboBox DockPanel.Dock="Right"
                                                                      Width="125"
                                                                      Visibility="{Binding LogicVisibility}"
                                                                      ItemsSource="{Binding LogicOptions}"
                                                                      SelectedItem="{Binding SelectedLogic, Mode=TwoWay}"
                                                                      ToolTip="{loc:Loc SourceDetails.ConditionLogicTooltip}" />
                                                        </DockPanel>

                                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                                            <ComboBox ItemsSource="{Binding TimeRangeOptions}"
                                                                      DisplayMemberPath="DisplayText"
                                                                      SelectedItem="{Binding SelectedTimeRange, Mode=TwoWay}"
                                                                      Visibility="{Binding IsTimeGroup, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                      ToolTip="{loc:Loc SourceDetails.ConditionTimeTooltip}" />
                                                            <ListBox ItemsSource="{Binding Rows}"
                                                                     Visibility="{Binding IsChoiceGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,1">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding DisplayText}"
                                                                                           FontSize="11"
                                                                                           TextWrapping="Wrap" />
                                                                                <TextBlock Text="{Binding DetailText}"
                                                                                           Foreground="{StaticResource MutedForeground}"
                                                                                           FontSize="9"
                                                                                           Margin="0,2,0,0"
                                                                                           TextWrapping="Wrap"
                                                                                           ToolTip="{Binding TechnicalText}" />
                                                                            </StackPanel>
                                                                            <ComboBox Grid.Column="1"
                                                                                      Width="94"
                                                                                      Margin="8,0,6,0"
                                                                                      ItemsSource="{Binding ChoiceOptions}"
                                                                                      SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                                                      Visibility="{Binding ShowChoice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                            <Button Grid.Column="2"
                                                                    Content="{loc:Loc SourceDetails.RemoveButton}"
                                                                                    Style="{StaticResource PopupButton}"
                                                                                    Padding="7,4"
                                                                                    Margin="0"
                                                                                    Tag="{Binding}"
                                                                                    Click="RemoveConditionRow_Click" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                            <ListBox ItemsSource="{Binding Rows}"
                                                                     Visibility="{Binding IsOtherGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding DisplayText}" FontSize="11" TextWrapping="Wrap" />
                                                                                <TextBlock Text="{Binding DetailText}"
                                                                                           Foreground="{StaticResource MutedForeground}"
                                                                                           FontSize="9"
                                                                                           Margin="0,2,0,0"
                                                                                           TextWrapping="Wrap" />
                                                                            </StackPanel>
                                                                            <Button Grid.Column="1"
                                                                            Content="{loc:Loc SourceDetails.RemoveButton}"
                                                                                    Style="{StaticResource PopupButton}"
                                                                                    Padding="7,4"
                                                                                    Margin="0"
                                                                                    Tag="{Binding}"
                                                                                    Click="RemoveConditionRow_Click" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </Grid>
                                                        <Button Grid.Row="2"
                                                                Content="{Binding AddButtonText}"
                                                                Tag="{Binding}"
                                                                Style="{StaticResource PopupButton}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,8,0,0"
                                                                Visibility="{Binding AddButtonVisibility}"
                                                                Click="AddConditionButton_Click" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding EditorStatusText}"
                       Foreground="{StaticResource MutedForeground}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Loc SourceDetails.CancelButton}" Style="{StaticResource PopupButton}" Click="CancelButton_Click" />
                <Button Content="{loc:Loc SourceDetails.SaveButton}" Style="{StaticResource PopupPrimaryButton}" Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
