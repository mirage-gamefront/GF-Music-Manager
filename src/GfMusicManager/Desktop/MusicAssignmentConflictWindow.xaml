<Window x:Class="GfMusicManager.Desktop.MusicAssignmentConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GfMusicManager.Desktop.Localization"
        Title="{loc:Loc Assignment.WindowTitle}"
        Width="900"
        Height="720"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#0e151f"
        Foreground="#edf2f8"
        ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="ConflictTemplate">
            <Border Background="#202a38"
                    BorderBrush="#40536e"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding TargetText}"
                               Foreground="#79b1ff"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <Border Background="#172435"
                            BorderBrush="#3c638d"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="{Binding IntegratedMusicTypeText}"
                                       Foreground="#79b1ff"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding IntegratedTrackText}"
                                       Foreground="#8bcaa6"
                                       FontSize="10"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding MusicTypeHeadingText}"
                               Foreground="#b7c4d5"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Assignments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#151d29"
                                        BorderBrush="#2f4057"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,6,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding MusicTypeText}"
                                                       Foreground="#79b1ff"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding AdoptedTrackText}"
                                                       DockPanel.Dock="Right"
                                                       Foreground="#8bcaa6"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding DefinitionText}"
                                                   Foreground="#c6d0df"
                                                   FontSize="10"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SourceModsText}"
                                                   Foreground="#8190a6"
                                                   FontSize="10"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:Loc Assignment.Heading}"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc Assignment.Description}"
                       Foreground="#9eacc0"
                       FontSize="12"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Conflicts}"
                              ItemTemplate="{StaticResource ConflictTemplate}" />
            </ScrollViewer>
            <TextBlock Text="{loc:Loc Assignment.Empty}"
                       Visibility="{Binding EmptyVisibility}"
                       Foreground="#9eacc0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding SummaryText}"
                       Foreground="#9eacc0"
                       FontSize="10"
                       VerticalAlignment="Center" />
            <Button Content="{loc:Loc Common.Close}"
                    DockPanel.Dock="Right"
                    Padding="14,7"
                    Background="#27364a"
                    BorderBrush="#4b617e"
                    Foreground="#edf2f8"
                    Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
