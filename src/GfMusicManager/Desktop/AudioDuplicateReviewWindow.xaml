<Window x:Class="GfMusicManager.Desktop.AudioDuplicateReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GfMusicManager.Desktop.Localization"
        Title="{loc:Loc AudioDuplicate.WindowTitle}"
        Width="920"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#0e151f"
        Foreground="#edf2f8"
        ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="AudioDuplicateGroupTemplate">
            <Border Background="#202a38"
                    BorderBrush="#40536e"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14"
                    Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding HeaderText}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ScoreText}"
                                   DockPanel.Dock="Right"
                                   Foreground="#f0cb8d"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding SubjectText}"
                               Foreground="#dce7f5"
                               FontSize="11"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#151d29"
                                        BorderBrush="#2f4057"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="9"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0"
                                                     GroupName="{Binding GroupName}"
                                                     Content="{loc:Loc Common.Adopt}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     Visibility="{Binding RadioVisibility}"
                                                     Foreground="#dceaff"
                                                     VerticalAlignment="Top"
                                                     Margin="0,2,8,0"
                                                     ToolTip="{loc:Loc AudioDuplicate.AdoptTooltip}" />
                                        <CheckBox Grid.Column="0"
                                                  Content="{loc:Loc Common.Adopt}"
                                                  IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                  Visibility="{Binding CheckBoxVisibility}"
                                                  Foreground="#dceaff"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,8,0"
                                                  ToolTip="{loc:Loc AudioDuplicate.AdoptTooltip}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="#79b1ff"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DetailText}"
                                                       Foreground="#c6d0df"
                                                       FontSize="10"
                                                       Margin="0,3,0,0"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding LocationText}"
                                                       Foreground="#8190a6"
                                                       FontSize="9"
                                                       Margin="0,3,0,0"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding UsageText}"
                                                       Foreground="#b7c4d5"
                                                       FontSize="9"
                                                       Margin="0,3,0,0"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding UsageDetailText}"
                                                       Foreground="#8190a6"
                                                       FontSize="9"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="{Binding PreviewButtonContent}"
                                                Tag="{Binding}"
                                                Padding="9,5"
                                                Margin="10,0,0,0"
                                                Background="#294d78"
                                                BorderBrush="#5d8bc3"
                                                Foreground="#edf2f8"
                                                Click="PreviewSourceButton_Click"
                                                ToolTip="{Binding PreviewButtonToolTip}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:Loc AudioDuplicate.Heading}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc AudioDuplicate.Description}"
                       Foreground="#9eacc0"
                       FontSize="12"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TabControl Grid.Row="1"
                    SelectedIndex="0"
                    Background="#151d29"
                    BorderBrush="#40536e">
            <TabItem Header="{Binding PathConflictTabHeader}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="#1a2432"
                            BorderBrush="#40536e"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="9"
                            Margin="0,0,0,8">
                        <TextBlock Text="{Binding PathConflictPageDescription}"
                                   Foreground="#b7c4d5"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </Border>
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding PathConflictGroups}"
                                          ItemTemplate="{StaticResource AudioDuplicateGroupTemplate}" />
                        </ScrollViewer>
                        <TextBlock Text="{loc:Loc AudioDuplicate.Empty}"
                                   Visibility="{Binding PathConflictEmptyVisibility}"
                                   Foreground="#9eacc0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding ContentMatchTabHeader}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="#1a2432"
                            BorderBrush="#40536e"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="9"
                            Margin="0,0,0,8">
                        <TextBlock Text="{Binding ContentMatchPageDescription}"
                                   Foreground="#b7c4d5"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc AudioDuplicate.Batch.Label}"
                                   Foreground="#b7c4d5"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Button Content="{loc:Loc AudioDuplicate.Batch.Prefer}"
                                Padding="9,5"
                                Margin="0,0,8,0"
                                Background="#294d78"
                                BorderBrush="#5d8bc3"
                                Foreground="#edf2f8"
                                Click="ContentMatchPreferLoadOrderButton_Click"
                                ToolTip="{loc:Loc AudioDuplicate.Batch.Prefer.ContentTooltip}" />
                        <Button Content="{loc:Loc AudioDuplicate.Batch.AdoptAll}"
                                Padding="9,5"
                                Margin="0,0,8,0"
                                Background="#294d78"
                                BorderBrush="#5d8bc3"
                                Foreground="#edf2f8"
                                Click="ContentMatchAdoptAllButton_Click"
                                ToolTip="{loc:Loc AudioDuplicate.Batch.AdoptAll.ContentTooltip}" />
                        <Button Content="{loc:Loc AudioDuplicate.Batch.ExcludeAll}"
                                Padding="9,5"
                                Background="#4b3440"
                                BorderBrush="#9b6577"
                                Foreground="#ffffff"
                                Click="ContentMatchExcludeAllButton_Click"
                                ToolTip="{loc:Loc AudioDuplicate.Batch.ExcludeAll.ContentTooltip}" />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ContentMatchGroups}"
                                          ItemTemplate="{StaticResource AudioDuplicateGroupTemplate}" />
                        </ScrollViewer>
                        <TextBlock Text="{loc:Loc AudioDuplicate.Empty}"
                                   Visibility="{Binding ContentMatchEmptyVisibility}"
                                   Foreground="#9eacc0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding SimilarCandidateTabHeader}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="#1a2432"
                            BorderBrush="#40536e"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="9"
                            Margin="0,0,0,8">
                        <TextBlock Text="{Binding SimilarCandidatePageDescription}"
                                   Foreground="#b7c4d5"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc AudioDuplicate.Batch.Label}"
                                   Foreground="#b7c4d5"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Button Content="{loc:Loc AudioDuplicate.Batch.Prefer}"
                                Padding="9,5"
                                Margin="0,0,8,0"
                                Background="#294d78"
                                BorderBrush="#5d8bc3"
                                Foreground="#edf2f8"
                                Click="SimilarCandidatePreferLoadOrderButton_Click"
                                ToolTip="{loc:Loc AudioDuplicate.Batch.Prefer.SimilarTooltip}" />
                        <Button Content="{loc:Loc AudioDuplicate.Batch.AdoptAll}"
                                Padding="9,5"
                                Margin="0,0,8,0"
                                Background="#294d78"
                                BorderBrush="#5d8bc3"
                                Foreground="#edf2f8"
                                Click="SimilarCandidateAdoptAllButton_Click"
                                ToolTip="{loc:Loc AudioDuplicate.Batch.AdoptAll.SimilarTooltip}" />
                        <Button Content="{loc:Loc AudioDuplicate.Batch.ExcludeAll}"
                                Padding="9,5"
                                Background="#4b3440"
                                BorderBrush="#9b6577"
                                Foreground="#ffffff"
                                Click="SimilarCandidateExcludeAllButton_Click"
                                ToolTip="{loc:Loc AudioDuplicate.Batch.ExcludeAll.SimilarTooltip}" />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SimilarCandidateGroups}"
                                          ItemTemplate="{StaticResource AudioDuplicateGroupTemplate}" />
                        </ScrollViewer>
                        <TextBlock Text="{loc:Loc AudioDuplicate.Empty}"
                                   Visibility="{Binding SimilarCandidateEmptyVisibility}"
                                   Foreground="#9eacc0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{loc:Loc AudioDuplicate.ApplyInstruction}"
                       Foreground="#9eacc0"
                       FontSize="10"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="14,0,0,0">
                <Button Content="{loc:Loc Common.Cancel}"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Background="#27364a"
                        BorderBrush="#4b617e"
                        Foreground="#edf2f8"
                        Click="CancelButton_Click" />
                <Button Content="{loc:Loc AudioDuplicate.ApplyButton}"
                        Padding="14,7"
                        Background="#4d80ba"
                        BorderBrush="#7da8dc"
                        Foreground="#ffffff"
                        FontWeight="SemiBold"
                        Click="ApplyButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
