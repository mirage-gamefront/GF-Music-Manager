<Window x:Class="GfMusicManager.Desktop.MusicFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GfMusicManager.Desktop.Localization"
        Title="{loc:Loc Filter.WindowTitle}"
        Width="700"
        Height="650"
        MinWidth="600"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0e151f"
        Foreground="#edf2f8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#1b2330" />
        <SolidColorBrush x:Key="PanelRaisedBackground" Color="#202a38" />
        <SolidColorBrush x:Key="InputBackground" Color="#141b25" />
        <SolidColorBrush x:Key="BorderBrush" Color="#344154" />
        <SolidColorBrush x:Key="MutedForeground" Color="#9aa8ba" />
        <SolidColorBrush x:Key="BluePanel" Color="#263d5c" />
        <SolidColorBrush x:Key="BlueAccent" Color="#78a9e8" />

        <!--
            WPFの標準ComboBoxテンプレートはWindowsテーマによって白い背景を
            強制することがあるため、フィルタ画面では表示を明示する
        -->
        <DataTemplate x:Key="FilterComboBoxItemDataTemplate">
            <TextBlock Text="{Binding DisplayText}"
                       Foreground="#edf2f8"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <ControlTemplate x:Key="FilterComboBoxItemControlTemplate" TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BluePanel}" />
                    <Setter Property="Foreground" Value="#ffffff" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BluePanel}" />
                    <Setter Property="Foreground" Value="#ffffff" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="FilterComboBoxTemplate" TargetType="{x:Type ComboBox}">
            <Grid SnapsToDevicePixels="True">
                <Border x:Name="ComboBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                    <Grid>
                        <ContentPresenter x:Name="SelectionPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                        <ToggleButton x:Name="DropDownButton"
                                      Width="28"
                                      HorizontalAlignment="Right"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ClickMode="Press"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="{TemplateBinding Foreground}"
                                      Padding="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent">
                                        <Path Data="M 0 0 L 8 0 L 4 5 Z"
                                              Fill="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                </Border>
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       Placement="Bottom"
                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                       PopupAnimation="Slide"
                       StaysOpen="False">
                    <Border Background="{StaticResource InputBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                        <ScrollViewer MaxHeight="300"
                                      CanContentScroll="True"
                                      Background="{StaticResource InputBackground}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource BlueAccent}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource BlueAccent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ComboBorder" Property="Opacity" Value="0.65" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="Background" Value="#273243" />
            <Setter Property="BorderBrush" Value="#42536a" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryFilterButton" TargetType="Button" BasedOn="{StaticResource FilterButton}">
            <Setter Property="Background" Value="#4e79ae" />
            <Setter Property="BorderBrush" Value="#78a9e8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#dce7f5" />
            <Setter Property="Margin" Value="0,4,16,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FilterComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="ToolTip" Value="{Binding DetailText}" />
            <Setter Property="Template" Value="{StaticResource FilterComboBoxItemControlTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Foreground" Value="#ffffff" />
                    <Setter Property="Background" Value="{StaticResource BluePanel}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#ffffff" />
                    <Setter Property="Background" Value="{StaticResource BluePanel}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="Background" Value="{StaticResource InputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource FilterComboBoxTemplate}" />
            <Setter Property="ItemTemplate" Value="{StaticResource FilterComboBoxItemDataTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FilterComboBoxItem}" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:Loc Filter.Heading}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc Filter.Description}"
                       Foreground="{StaticResource MutedForeground}"
                       FontSize="12"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Filter.PlaybackHeading}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BlueAccent}" />
                        <TextBlock Text="{loc:Loc Filter.PlaybackDescription}"
                                   Foreground="{StaticResource MutedForeground}"
                                   FontSize="11"
                                   Margin="0,4,0,10" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="CombatCheckBox"
                                      Content="{loc:Loc Filter.Combat}"
                                      Checked="PlaybackFilterCheckBox_Changed"
                                      Unchecked="PlaybackFilterCheckBox_Changed" />
                            <ComboBox x:Name="CombatComboBox"
                                      Grid.Column="1"
                                      Margin="0,0,0,6"
                                      SelectedValuePath="Key" />

                            <CheckBox x:Name="TimeOfDayCheckBox"
                                      Grid.Row="1"
                                      Content="{loc:Loc Filter.TimeOfDay}"
                                      Checked="PlaybackFilterCheckBox_Changed"
                                      Unchecked="PlaybackFilterCheckBox_Changed" />
                            <ComboBox x:Name="TimeOfDayComboBox"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="0,0,0,6"
                                      SelectedValuePath="Key" />

                            <CheckBox x:Name="WeatherCheckBox"
                                      Grid.Row="2"
                                      Content="{loc:Loc Filter.Weather}"
                                      Checked="PlaybackFilterCheckBox_Changed"
                                      Unchecked="PlaybackFilterCheckBox_Changed" />
                            <ComboBox x:Name="WeatherComboBox"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      Margin="0,0,0,6"
                                      SelectedValuePath="Key" />

                            <CheckBox x:Name="OtherConditionCheckBox"
                                      Grid.Row="3"
                                      Content="{loc:Loc Filter.OtherCondition}"
                                      Checked="PlaybackFilterCheckBox_Changed"
                                      Unchecked="PlaybackFilterCheckBox_Changed" />
                            <ComboBox x:Name="OtherConditionComboBox"
                                      Grid.Row="3"
                                      Grid.Column="1"
                                      Margin="0,0,0,6"
                                      SelectedValuePath="Key" />

                            <CheckBox x:Name="NoConditionCheckBox"
                                      Grid.Row="4"
                                      Content="{loc:Loc Filter.NoCondition}"
                                      Checked="PlaybackFilterCheckBox_Changed"
                                      Unchecked="PlaybackFilterCheckBox_Changed"
                                      Margin="0,4,16,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Filter.DefinitionHeading}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BlueAccent}" />
                        <TextBlock Text="{loc:Loc Filter.DefinitionDescription}"
                                   Foreground="{StaticResource MutedForeground}"
                                   FontSize="11"
                                   Margin="0,4,0,12"
                                   TextWrapping="Wrap" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="MusicTypeCheckBox"
                                      Content="{loc:Loc Filter.MusicType}"
                                      Checked="DefinitionCheckBox_Changed"
                                      Unchecked="DefinitionCheckBox_Changed" />
                            <TextBox x:Name="MusicTypeQueryTextBox"
                                     Grid.Column="1"
                                     Margin="0,0,0,8" />
                            <CheckBox x:Name="CellCheckBox"
                                      Grid.Row="1"
                                      Content="{loc:Loc Filter.Cell}"
                                      Checked="DefinitionCheckBox_Changed"
                                      Unchecked="DefinitionCheckBox_Changed" />
                            <TextBox x:Name="CellQueryTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,0,0,8" />
                            <CheckBox x:Name="WorldSpaceCheckBox"
                                      Grid.Row="2"
                                      Content="{loc:Loc Filter.WorldSpace}"
                                      Checked="DefinitionCheckBox_Changed"
                                      Unchecked="DefinitionCheckBox_Changed" />
                            <TextBox x:Name="WorldSpaceQueryTextBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Margin="0,0,0,8" />
                            <CheckBox x:Name="RegionCheckBox"
                                      Grid.Row="3"
                                      Content="{loc:Loc Filter.Region}"
                                      Checked="DefinitionCheckBox_Changed"
                                      Unchecked="DefinitionCheckBox_Changed" />
                            <TextBox x:Name="RegionQueryTextBox"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Margin="0,0,0,8" />
                            <CheckBox x:Name="LocationCheckBox"
                                      Grid.Row="4"
                                      Content="{loc:Loc Filter.Location}"
                                      Checked="DefinitionCheckBox_Changed"
                                      Unchecked="DefinitionCheckBox_Changed"
                                      Margin="0,4,16,0" />
                            <TextBox x:Name="LocationQueryTextBox"
                                     Grid.Row="4"
                                     Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Content="{loc:Loc Filter.Clear}"
                    Style="{StaticResource FilterButton}"
                    Click="ClearButton_Click"
                    DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Filter.Cancel}"
                        Style="{StaticResource FilterButton}"
                        Click="CancelButton_Click" />
                <Button Content="{loc:Loc Filter.Apply}"
                        Style="{StaticResource PrimaryFilterButton}"
                        Click="ApplyButton_Click"
                        Margin="0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
