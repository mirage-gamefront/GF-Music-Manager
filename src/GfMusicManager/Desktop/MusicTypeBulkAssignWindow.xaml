<Window x:Class="GfMusicManager.Desktop.MusicTypeBulkAssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GfMusicManager.Desktop.Localization"
        Title="{loc:Loc Bulk.WindowTitle}"
        Width="760"
        Height="700"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0f141c"
        Foreground="#edf2f8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#1b2330" />
        <SolidColorBrush x:Key="BorderBrush" Color="#344154" />
        <SolidColorBrush x:Key="MutedForeground" Color="#9aa8ba" />
        <SolidColorBrush x:Key="BluePanel" Color="#263d5c" />
        <SolidColorBrush x:Key="BlueAccent" Color="#78a9e8" />

        <Style x:Key="PickerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="Background" Value="#273243" />
            <Setter Property="BorderBrush" Value="#42536a" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PickerPrimaryButton" TargetType="Button" BasedOn="{StaticResource PickerButton}">
            <Setter Property="Background" Value="#4e79ae" />
            <Setter Property="BorderBrush" Value="#78a9e8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="Background" Value="#141b25" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#141b25" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202a38" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BluePanel}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{loc:Loc Bulk.Heading}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc Bulk.Description}"
                       Foreground="{StaticResource MutedForeground}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Margin="0,5,0,0" />
        </StackPanel>

        <TextBox x:Name="SearchTextBox"
                 Grid.Row="1"
                 TextChanged="SearchTextBox_TextChanged"
                 ToolTip="{loc:Loc Bulk.SearchTooltip}"
                 Margin="0,14,0,8" />

        <ListBox x:Name="MusicTypeListBox"
                 Grid.Row="2"
                 ItemsSource="{Binding FilteredOptions}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Tag="{Binding}"
                              Checked="OptionCheckBox_Changed"
                              Unchecked="OptionCheckBox_Changed">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="{Binding DisplayText}"
                                       Foreground="{StaticResource BlueAccent}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailText}"
                                       Foreground="{StaticResource MutedForeground}"
                                       FontSize="10"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding SelectedSummaryText}"
                       Foreground="{StaticResource MutedForeground}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Common.Cancel}" Style="{StaticResource PickerButton}" Click="CancelButton_Click" />
                <Button Content="{loc:Loc Common.Add}" Style="{StaticResource PickerPrimaryButton}" Click="AddButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
