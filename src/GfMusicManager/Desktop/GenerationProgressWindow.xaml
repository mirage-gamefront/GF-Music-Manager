<Window x:Class="GfMusicManager.Desktop.GenerationProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Loc Main.GenerationProgressDialogTitle}"
        xmlns:loc="clr-namespace:GfMusicManager.Desktop.Localization"
        Width="560" Height="250"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#111923"
        Foreground="#f3f7fc"
        Closing="Window_Closing">
    <Border Margin="18" Padding="22" Background="#202a38" BorderBrush="#526b8b" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{loc:Loc Main.GenerationProgressDialogHeading}"
                       FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="StageText" Grid.Row="1" Margin="0,12,0,0"
                       Foreground="#c6d0df" TextWrapping="Wrap" />
            <ProgressBar x:Name="GenerationProgressBar" Grid.Row="2" Height="14" Margin="0,18,0,0"
                         Minimum="0" Maximum="100" />
            <Grid Grid.Row="3" Margin="0,9,0,0">
                <TextBlock x:Name="CountText" Foreground="#8fa1b8" />
                <TextBlock x:Name="PercentText" HorizontalAlignment="Right" Foreground="#83b9f4" FontWeight="SemiBold" />
            </Grid>
        </Grid>
    </Border>
</Window>
