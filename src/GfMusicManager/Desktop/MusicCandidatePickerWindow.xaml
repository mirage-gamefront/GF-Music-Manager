<Window x:Class="GfMusicManager.Desktop.MusicCandidatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GfMusicManager.Desktop.Localization"
        Title="{Binding PickerTitle}"
        Width="640"
        Height="620"
        MinWidth="520"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0f141c"
        Foreground="#edf2f8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#1b2330" />
        <SolidColorBrush x:Key="BorderBrush" Color="#344154" />
        <SolidColorBrush x:Key="MutedForeground" Color="#9aa8ba" />
        <SolidColorBrush x:Key="BluePanel" Color="#263d5c" />
        <SolidColorBrush x:Key="BlueAccent" Color="#78a9e8" />
        <Style x:Key="PickerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="Background" Value="#273243" />
            <Setter Property="BorderBrush" Value="#42536a" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PickerPrimaryButton" TargetType="Button" BasedOn="{StaticResource PickerButton}">
            <Setter Property="Background" Value="#4e79ae" />
            <Setter Property="BorderBrush" Value="#78a9e8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="Background" Value="#141b25" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#141b25" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#edf2f8" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202a38" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BluePanel}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding PickerTitle}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Text="{Binding PickerPrompt}"
                   Foreground="{StaticResource MutedForeground}"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Margin="0,5,0,10" />
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchTextBox"
                     TextChanged="SearchTextBox_TextChanged"
                     ToolTip="{loc:Loc Candidate.SearchTooltip}"
                     Margin="0,0,0,8" />
            <ListBox x:Name="CandidateListBox"
                     Grid.Row="1"
                     ItemsSource="{Binding FilteredOptions}"
                     SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayText}"
                                       Foreground="{StaticResource BlueAccent}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailText}"
                                       Foreground="{StaticResource MutedForeground}"
                                       FontSize="10"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Loc Common.Cancel}" Style="{StaticResource PickerButton}" Click="CancelButton_Click" />
            <Button Content="{loc:Loc Common.Add}" Style="{StaticResource PickerPrimaryButton}" Click="AddButton_Click" />
        </StackPanel>
    </Grid>
</Window>
